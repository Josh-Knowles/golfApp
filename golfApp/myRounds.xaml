<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="golfApp.myRounds"
             Title="myRounds">
    <Grid BackgroundColor="DarkGreen">
        <VerticalStackLayout>
            <Label
                x:Name="lblDate"
                Text="Date"
                VerticalOptions="Center"
                HorizontalOptions="Center" />
            <Label
                x:Name="lblTotal"
                Text="Total Score"
                VerticalOptions="Center"
                HorizontalOptions="Center" />
            <Label
                x:Name="lblPar"
                Text="Par"
                VerticalOptions="Center"
                HorizontalOptions="Center" />
            <Label
                x:Name="lblCourse"
                Text="Course"
                VerticalOptions="Center"
                HorizontalOptions="Center" />
            <Label 
                x:Name="lblScores"
                Text="scores"
                VerticalOptions="Center" 
                HorizontalOptions="Center" />
            
        </VerticalStackLayout>
    </Grid>
    
</ContentPage>