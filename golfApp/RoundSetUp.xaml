<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="golfApp.RoundSetUp"
             Title="RoundSetUp">
    <VerticalStackLayout>
        <Label 
            Text="Select Course"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Picker x:Name="CoursePicker" 
                VerticalOptions="Center" 
                HorizontalOptions="Center"
                SelectedIndexChanged="CoursePicker_SelectedIndexChanged">
            <Picker.Items>
                
                <x:String>Chisholm Links</x:String>
                <x:String>Saint CLair</x:String>
                <x:String>Gladfield</x:String>

            </Picker.Items>
            
        </Picker>

        <Label 
    Text="Amount of holes"
    VerticalOptions="Center" 
    HorizontalOptions="Center" />
        <Picker x:Name="holePicker" 
        VerticalOptions="Center" 
        HorizontalOptions="Center"
        SelectedIndexChanged="holePicker_SelectedIndexChanged" >
            <Picker.Items>
                <x:String>9 Holes</x:String>
                <x:String>18 Holes</x:String>
            </Picker.Items>

        </Picker>

        <Button
            x:Name="btnRoundSart"
    BackgroundColor="DarkGreen"
    Text="Start Round"
    TextColor="White"
    HeightRequest="60"
    FontSize="24"
    Clicked="btnRoundSart_Clicked"/>
    </VerticalStackLayout>
</ContentPage>